{
  "name": "sketchbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sketch:meta": "node scripts/watch-sketches.mjs",
    "sketch:meta:write": "node scripts/watch-sketches.mjs --once",
    "sketch:clean-assets": "node scripts/remove-orphan-thumbnails.mjs",
    "dev": "next dev --turbopack",
    "watch": "node scripts/dev-watch.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache --cache-location .next/cache/eslint src scripts eslint.config.mjs next.config.ts tailwind.config.ts postcss.config.mjs",
    "lint:fix": "eslint --cache --cache-location .next/cache/eslint --fix src scripts eslint.config.mjs next.config.ts tailwind.config.ts postcss.config.mjs",
    "format": "npm run lint:fix",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "typecheck:watch": "node node_modules/typescript7/bin/tsc --noEmit --watch",
    "check": "npm run lint && npm run typecheck && npm test",
    "test": "jest",
    "test:watch": "jest --watch",
    "postinstall": "npx prisma generate",
    "setup:notifications": "node scripts/generate-vapid-keys.mjs",
    "prepare": "husky && node scripts/setup-git-merge-drivers.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.2.1",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@types/archiver": "^8.0.0",
    "@types/tar": "^6.1.13",
    "@use-gesture/react": "^10.3.1",
    "archiver": "^8.0.0",
    "bullmq": "^5.81.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exifreader": "^4.41.3",
    "gif.js": "^0.2.0",
    "gsap": "^3.13.0",
    "heic2any": "^0.0.4",
    "immer": "^11.1.15",
    "ioredis": "^5.11.1",
    "json-edit-react": "^1.30.2",
    "lucide-react": "^1.27.0",
    "mediabunny": "^1.51.0",
    "mime-types": "^3.0.2",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "p5": "^1.9.4",
    "playwright": "^1.62.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tar": "^7.5.22",
    "three": "^0.185.1",
    "uuid": "^14.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.1.1",
    "@types/p5": "^1.7.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@types/web-push": "^3.6.3",
    "chokidar": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "eslint-plugin-next": "^0.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.23",
    "prisma": "^7.9.0",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --cache --cache-location .next/cache/eslint --fix"
    ]
  }
}
