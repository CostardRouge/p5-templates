# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# editor / IDE state — machine-specific, never part of a commit
.idea/
.vscode/

# misc
.DS_Store
*.pem
*.key
*.p12
*.keystore

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit a real one. The template is the exception:
# setup.sh copies .env.example to .env on a fresh clone, so it has to be
# committable (see the open item in MEMORY.md — the file itself is missing).
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


/public/assets/images/samples
/public/assets/libraries

/src/generated/prisma
prisma/prisma/database.db
/tmp
