generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  queued
  active
  completed
  failed
  cancelled
  draft
}

// A saved, named configuration of a sketch. Mapped onto the historical
// "Template"/"TemplateSnapshot" tables so the rename needs no SQL migration.
model Preset {
  id          String           @id @default(uuid())
  name        String // e.g., "p5/mySketch"
  description String?
  options     Json // Current mutable configuration
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  snapshots   PresetSnapshot[]

  @@unique([name])
  @@map("Template")
}

model PresetSnapshot {
  id        String   @id @default(uuid())
  presetId  String   @map("templateId")
  preset    Preset   @relation(fields: [presetId], references: [id], onDelete: Cascade)
  name      String // Snapshot of preset name at creation time
  options   Json // Immutable snapshot of options
  createdAt DateTime @default(now())
  jobs      Job[]

  @@index([presetId])
  @@map("TemplateSnapshot")
}

model Job {
  id                String          @id
  snapshotId        String?
  snapshot          PresetSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  // Sketch route path ("sketches/{engine}/{category?}/{name}"). Stored values
  // predating the /sketches rename keep their "templates/…" prefix — the
  // permanent redirect keeps them loadable, so never rewrite them.
  sketch            String          @map("template")
  status            JobStatus
  resultUrl         String?
  thumbnails        Json? // Array of thumbnail URLs for each slide/video
  videoUrls         Json? // Array of video URLs for multi-slide recordings
  videoSizes        Json? // Array of video file sizes in bytes
  recordingStartAt  DateTime? // When recording processing started
  recordingEndAt    DateTime? // When recording processing completed
  recordingDuration Int? // Recording duration in milliseconds
  progress          Int
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  options           Json? // Legacy: inline options for backward compatibility

  @@index([snapshotId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
