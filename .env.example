# ─── App ───────────────────────────────────────────────────────────────────
APP_PORT=3000
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=recordings
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
REDIS_URL=redis://redis:6379
WORKER_CONCURRENCY=2
BACKEND_RECORDING=true
NOTIFICATIONS=true
LIVE_THUMBNAIL=true
INTERACTION_BINDINGS=true
# Web-push key pair. Left empty on purpose: a private key in a committed file
# signs pushes for every install that copied it. `npm run setup:notifications`
# (also run by setup.sh) fills both into .env with a pair unique to this install.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: SITE_URL in src/config/site.ts is the default for a production
# build. Set this only to point a build somewhere else (a preview, a fork).
NEXT_PUBLIC_SITE_URL=https://p5.steeve.website
VERCEL_URL=p5.steeve.website
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/CostardRouge/sketchbook

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── S3 / MinIO ────────────────────────────────────────────────────────────
MINIO_ROOT_USER=${S3_ACCESS_KEY}
MINIO_ROOT_PASSWORD=${S3_SECRET_KEY}
S3_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_DB=social-pipeline
POSTGRES_USER=social-pipeline-user
POSTGRES_PASSWORD=social-pipeline-pass
POSTGRES_PORT=5432

# ─── Database (Prisma) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://social-pipeline-user:social-pipeline-pass@postgres:5432/social-pipeline
PRISMA_DISABLE_SHADOW_DATABASE=true